# Dual-GAM — Container h-target (servidor alvo)
# Servidor HTTP simples que recebe o tráfego do ataque.
# Em iterações futuras, este container também rodará o Defensor SDN.

FROM python:3.11-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

RUN apt-get update && apt-get install -y --no-install-recommends \
    tcpdump \
    net-tools \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY h-target/ .

RUN pip install --no-cache-dir flask

EXPOSE 80

CMD ["python", "server.py"]
